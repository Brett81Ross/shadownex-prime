# Server-only keys (Vercel Project Settings -> Environment Variables)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
FIRMS_MAP_KEY=

# Aircraft
# ADSB.lol is the default public ADS-B/MLAT source and does not require a key.
# OpenSky is an optional bounded fallback only. Leave disabled unless your intended use
# is authorized under OpenSky's current terms.
OPENSKY_FALLBACK_ENABLED=false
